venv/
*.egg-info/
dist/
build/

# Competition data must never be committed
data/raw/
data/processed/
*.dcm
*.zip
*.tar
*.tar.gz

# Generated run artifacts
artifacts/
outputs/
checkpoints/
experiments/results/*.csv
experiments/cards/*.json

# Keep fixtures (synthetic only)
!data/fixtures/
!data/fixtures/**
!experiments/results/.gitkeep
!experiments/cards/.gitkeep
